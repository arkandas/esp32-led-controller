#pragma once

// ── WiFi ─────────────────────────────────────────────────────────────────────
#define WIFI_SSID       "your_wifi_ssid"
#define WIFI_PASSWORD   "your_wifi_password"
#define WIFI_HOSTNAME   "ESP32_LED_CONTROLLER"

// ── Names ─────────────────────────────────────────────────────────────────────
#define DEVICE_NAME     "Living Room LED Controller"  // The whole device — shown as the web page title
#define STRIP_NAME_1    "Couch Lights"                // Strip 1 (GPIO40) — Alexa device name + web selector label
#define STRIP_NAME_2    "Shelf Lights"                // Strip 2 (GPIO41) — Alexa device name + web selector label

// ── OTA ───────────────────────────────────────────────────────────────────────
#define OTA_PASSWORD    "your_ota_password"

// ── Web server ────────────────────────────────────────────────────────────────
#define WEB_SERVER_PORT 8081

// ── LED strips ────────────────────────────────────────────────────────────────
#define NUM_LEDS        60   // Strip 1 on GPIO40
#define NUM_LEDS_2      60   // Strip 2 on GPIO41
